        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();\nconst token = res.access_token;\n\npm.collectionVariables.set(\"access_token\", token);\n\nconst payload = token.split('.')[1];\nconst decoded = JSON.parse(\n    Buffer.from(payload.replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString('utf8')\n);\n\nconst user_id = decoded.sub;\n\npm.collectionVariables.set(\"user_id\", user_id);\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"TestPass\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
